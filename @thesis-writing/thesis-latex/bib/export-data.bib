@inproceedings{plotnikov_multitask_2025,
	title = {Multitask {Learning} for {Estimating} {Primary} {Forest} {Characteristics} {Using} {Sentinel}-2 {Data}},
	url = {https://ieeexplore.ieee.org/abstract/document/11079121},
	doi = {10.1109/I2MTC62753.2025.11079121},
	abstract = {Recent significant advances in sensors and remote measurement technologies are opening new avenues for ecological applications. Remote sensing techniques enhance data capture over vast territories, particularly for estimating forest characteristics based on multispectral patterns of vegetation cover. Machine learning algorithms have demonstrated effectiveness in processing such data for automated solutions. Traditionally, the prediction of various forestry parameters has relied on the development of independent models for each parameter. However, parameters such as basal area, forest height, and growing stock volume are highly interrelated and can be predicted using the same input feature space. In this study, we explore an alternative approach to forest characteristic prediction within a multitask framework, where the model utilizes a joint feature space to provide multiple output regression parameters. We conducted our research in Sakhalin forestry, leveraging multispectral images from Sentinel-2. This multitask approach was compared to a conventional method in which individual machine learning models are trained for each parameter. The best results were achieved using the CatBoost MultiOutputRegressor, yielding R2 scores of 0.75, 0.75, and 0.76 for height, timber stock, and basal area, respectively. In contrast, single-task models produced lower R2 scores of 0.65, 0.62, and 0.83 for the same parameters. We also explored and compared multitask Gaussian process regression and the Wasserstein multitask model. By modeling all outputs together, the MultiOutputRegressor method can implicitly capture relationships between the environmental outputs, improving prediction accuracy for the correlated variables, reducing computational overhead, and enhancing generalizability.},
	urldate = {2026-01-07},
	booktitle = {2025 {IEEE} {International} {Instrumentation} and {Measurement} {Technology} {Conference} ({I2MTC})},
	author = {Plotnikov, Elisey and Rudkevich, Konstantin and Illarionova, Svetlana and Tregubova, Polina and Shadrin, Dmitrii and Burnaev, Evgeny},
	month = may,
	year = {2025},
	note = {ISSN: 2642-2077},
	keywords = {Accuracy, Biological system modeling, Computational modeling, Forestry, Machine learning, Predictive models, Remote sensing, Sensor phenomena and characterization, Sensor systems, Vegetation mapping, machine learning, multitask learning, pattern recognition, remote sensing},
	pages = {1--6},
}

@article{shen_learning_2025,
	title = {Learning {Cross}-{Task} {Features} {With} {Mamba} for {Remote} {Sensing} {Image} {Multitask} {Prediction}},
	volume = {63},
	issn = {1558-0644},
	url = {https://ieeexplore.ieee.org/document/10879310},
	doi = {10.1109/TGRS.2025.3540573},
	abstract = {Multitask learning (MTL) for remote sensing (RS) image is a rapidly evolving field that requires simultaneous predictions across several related tasks. However, many existing MTL methods often overlook the exploring of cross-task features, while the strong interdependencies among tasks are critical for MTL. In this article, we propose RSMTMamba, an innovative MTL framework that integrates Mamba for multitask prediction in RS images. Our network simultaneously performs semantic segmentation, height estimation, and boundary detection within a unified architecture. The proposed architecture prioritizes the decoder, with a shared encoder for feature extraction. Specifically, a Mamba-based cross-task feature learning (MCFL) module is introduced to capture the interrelations among different tasks. Unlike transformer-based architecture, which requires significant computational resources, the MCFL module can model both local and global cross-task relationships for RS image with linear complexity. Additionally, Mamba-integrated refine decoders are utilized to aggregate features from the encoder, preliminary decoders, and the MCFL module, which enhances multitask prediction performance. The experimental results on three RS datasets demonstrate that our proposed CFLMamba achieves the state-of-the-art prediction performance, outperforming several deep neural networks in RS image analysis. The code is available at https://github.com/sycs-2024/RSMultitaskMamba.},
	urldate = {2026-01-07},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Shen, Yu and Xiao, Liang and Chen, Jianyu and Du, Qian and Ye, Qiaolin},
	year = {2025},
	keywords = {Boundary detection, Computational modeling, Computer architecture, Decoding, Estimation, Feature extraction, Mamba, Multitasking, Predictive models, Remote sensing, Semantic segmentation, Transformers, height estimation, multitask learning (MTL), remote sensing (RS), semantic segmentation, state space model (SSM)},
	pages = {1--16},
}

@article{liu_associatively_2022,
	title = {Associatively {Segmenting} {Semantics} and {Estimating} {Height} {From} {Monocular} {Remote}-{Sensing} {Imagery}},
	volume = {60},
	issn = {1558-0644},
	url = {https://ieeexplore.ieee.org/document/9781388},
	doi = {10.1109/TGRS.2022.3177796},
	abstract = {Numerous deep-learning methods have been successfully applied to semantic segmentation (SS) and height estimation (EH) of remote-sensing imagery. It has also been proved that such a framework can be reusable for multiple tasks to reduce computational resource overhead. However, there are still some technical limitations due to the semantic inconsistency between 3-D and 2-D features and the strong interference of different objects with similar spectral–spatial properties. Previous works have sought to address these issues through hard (HPS) or soft parameter sharing (SPS) schemes. But due to unintentional integration, the specific information transmitted between multiple tasks is not clear or in a lot of redundancy. Furthermore, tuning the weights by hand between classification and regression loss functions is challenging. In this article, a novel multitask learning (MTL) method, termed associatively segmenting semantics and estimating height (ASSEH), is proposed to associatively segment semantics and estimate height from monocular remote-sensing imagery. First, considering semantic inconsistency across tasks, we design a task-specific distillation (TSD) module containing a set of task-specific gating units (TSGUs) for each task at the cost of fewer parameters. The module allows for task-specific features to be tailored from the backbone while allowing for task-shared features to be transmitted. Second, we leverage the proposed cross-task propagation (CTP) module to construct and diffuse the local pattern graphlets at the common positions across tasks. Such a high-order recursive method can bridge two tasks explicitly to effectively settle semantic ambiguities caused by similar spectral characteristics with less computational burden and memory requirements. Third, a dynamic weighted geometric mean (DWGeoMean) strategy is introduced to dynamically learn the weights of each task and be more robust to the magnitude of the loss function. Finally, the results of the ISPRS Vaihingen dataset and the urban semantic 3-D (US3D) dataset well demonstrate that our ASSEH achieves state-of-the-art performance.},
	urldate = {2026-01-07},
	journal = {IEEE Transactions on Geoscience and Remote Sensing},
	author = {Liu, Wenjie and Sun, Xian and Zhang, Wenkai and Guo, Zhi and Fu, Kun},
	year = {2022},
	keywords = {Convolution, Estimation, Height estimation (EH), Image segmentation, Multitasking, Remote sensing, Semantics, Task analysis, multitask learning (MTL), remote-sensing imagery, semantic segmentation (SS)},
	pages = {1--17},
}

@inproceedings{srivastava_joint_2017,
	title = {Joint height estimation and semantic labeling of monocular aerial images with {CNNS}},
	url = {https://ieeexplore.ieee.org/document/8128167},
	doi = {10.1109/IGARSS.2017.8128167},
	abstract = {We aim to jointly estimate height and semantically label monocular aerial images. These two tasks are traditionally addressed separately in remote sensing, despite their strong correlation. Therefore, a model learning both height and classes jointly seems advantageous and so, we propose a multitask Convolutional Neural Network (CNN) architecture with two losses: one performing semantic labeling, and another predicting normalized Digital Surface Model (nDSM) from the pixel values. Since the nDSM/height information is used only in the second loss, there is no need to have a nDSM map at test time, and the model can estimate height automatically on new images. We test our proposed method on a set of sub-decimeter resolution images and show that our model equals the performances of two separate models, but at the cost of a single one.},
	urldate = {2026-01-07},
	booktitle = {2017 {IEEE} {International} {Geoscience} and {Remote} {Sensing} {Symposium} ({IGARSS})},
	author = {Srivastava, Shivangi and Volpi, Michele and Tuia, Devis},
	month = jul,
	year = {2017},
	note = {ISSN: 2153-7003},
	keywords = {Convolutional neural networks, Digital Surface Model, Estimation, Image resolution, Labeling, Multitask learning, Predictive models, Semantic labeling, Semantics, Training},
	pages = {5173--5176},
}

@inproceedings{mahesh_better_2025,
	title = {Better {Coherence}, {Better} {Height}: {Fusing} {Physical} {Models} and {Deep} {Learning} for {Forest} {Height} {Estimation} from {Interferometric} {SAR} {Data}},
	shorttitle = {Better {Coherence}, {Better} {Height}},
	url = {https://ieeexplore.ieee.org/document/11147830},
	doi = {10.1109/CVPRW67362.2025.00219},
	abstract = {Estimating forest height from Synthetic Aperture Radar (SAR) images often relies on traditional physical models, which, while interpretable and data-efficient, can struggle with generalization. In contrast, Deep Learning (DL) approaches lack physical insight. To address this, we propose CoHNet - an end-to-end framework that combines the best of both worlds: DL optimized with physics-informed constraints. We leverage a pre-trained neural surrogate model to enforce physical plausibility through a unique training loss. Our experiments show that this approach not only improves forest height estimation accuracy but also produces meaningful features that enhance the reliability of predictions. All code and models are available at https://github.com/ragbm/CoHNet.},
	urldate = {2026-01-07},
	booktitle = {2025 {IEEE}/{CVF} {Conference} on {Computer} {Vision} and {Pattern} {Recognition} {Workshops} ({CVPRW})},
	author = {Mahesh, Ragini Bal and Hänsch, Ronny},
	month = jun,
	year = {2025},
	note = {ISSN: 2160-7516},
	keywords = {Biological system modeling, Coherence, Computational modeling, Data models, Decorrelation, Deep learning, Estimation, Forestry, Predictive models, Solid modeling, deep learning, forest height, hybrid models, physics-informed deep learning, sar},
	pages = {2320--2329},
}

@article{grace_tree_2024,
	title = {Tree {Species} {Classification} using {Machine} {Learning} and {3D} {Tomographic} {SAR} -- a case study in {Northern} {Europe}},
	copyright = {Creative Commons Attribution Share Alike 4.0 International},
	url = {https://arxiv.org/abs/2411.12897},
	doi = {10.48550/ARXIV.2411.12897},
	abstract = {Tree species classification plays an important role in nature conservation, forest inventories, forest management, and the protection of endangered species. Over the past four decades, remote sensing technologies have been extensively utilized for tree species classification, with Synthetic Aperture Radar (SAR) emerging as a key technique. In this study, we employed TomoSense, a 3D tomographic dataset, which utilizes a stack of single-look complex (SLC) images, a byproduct of SAR, captured at different incidence angles to generate a three-dimensional representation of the terrain. Our research focuses on evaluating multiple tabular machine-learning models using the height information derived from the tomographic image intensities to classify eight distinct tree species. The SLC data and tomographic imagery were analyzed across different polarimetric configurations and geosplit configurations. We investigated the impact of these variations on classification accuracy, comparing the performance of various tabular machine-learning models and optimizing them using Bayesian optimization. Additionally, we incorporated a proxy for actual tree height using point cloud data from Light Detection and Ranging (LiDAR) to provide height statistics associated with the model's predictions. This comparison offers insights into the reliability of tomographic data in predicting tree species classification based on height.},
	urldate = {2026-01-07},
	author = {Grace, Colverd and Laura, Schade and Jumpei, Takami and Karol, Bot and Joseph, Gallego},
	year = {2024},
	keywords = {Computer Vision and Pattern Recognition (cs.CV), Data Analysis, Statistics and Probability (physics.data-an), FOS: Computer and information sciences, FOS: Physical sciences, Machine Learning (cs.LG)},
}

